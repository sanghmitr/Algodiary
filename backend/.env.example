DATABASE_URL=postgresql+asyncpg://user:pass@localhost/preptracker
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=<random 32 char string>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
VAPID_PRIVATE_KEY=<generate with py-vapid>
VAPID_PUBLIC_KEY=<generate with py-vapid>
VAPID_CLAIM_EMAIL=your@email.com
BREVO_SMTP_KEY=<from brevo free account>
R2_BUCKET=<cloudflare r2 bucket>
R2_ENDPOINT=<r2 endpoint url>
R2_PUBLIC_URL=<public r2 custom domain, optional>
R2_ACCESS_KEY=<r2 access key>
R2_SECRET_KEY=<r2 secret key>
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://127.0.0.1:5173
ENVIRONMENT=development
